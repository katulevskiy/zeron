# Copy to .env for live mode. Do not commit credentials.
PUBLIC_URL=https://review.example.com
HOST=0.0.0.0
PORT=3080
DATA_PATH=/app/data/review.sqlite
POLICY_PATH=/app/policy.json
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Keep off until the installation, policy, and imported data have been checked.
GITHUB_WRITEBACK=false
# Optional server-issued bearer tokens mapped to accountable GitHub logins.
# Each token must have at least 32 characters. Never put these in browser code.
AGENT_TOKENS={}
