[Unit]
Description=Zeron Contribution Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contribution-manager
Group=contribution-manager
WorkingDirectory=/var/lib/contribution-manager
EnvironmentFile=/etc/contribution-manager.env
ExecStart=/opt/contribution-manager/current/zeron-review
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contribution-manager
MemoryMax=384M
CPUQuota=100%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
