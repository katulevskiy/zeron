<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window paints Zeron's background from the first frame (no white
         flash before Compose draws); edge-to-edge is enabled in MainActivity. -->
    <style name="Theme.Zeron" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zeron_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
