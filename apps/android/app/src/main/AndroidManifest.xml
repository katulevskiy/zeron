<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Opening a received APK hands it to the package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Haptics (VibrationEffect / composition primitives); a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Session alerts (finished, needs input, failed) while the app is in the background; asked once, in context. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Explicit speech-provider discovery for the Android 10/11 legacy
         recognizer contract; newer Android keeps its existing provider. -->
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>

    <application
        android:name=".ZeronApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Zeron.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- WorkOS sign-in returns to zeron://callback (shared with iOS). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zeron" android:host="callback" />
            </intent-filter>
        </activity>
        <!-- "Share to Zeron": send files from any app to one of your devices. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Send with Zeron"
            android:theme="@style/Theme.Zeron"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- System-owned assistant window; no draw-over-other-apps permission. -->
        <service android:name=".voice.assistant.JarvisAssistantService"
            android:label="Zeron Jarvis" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/jarvis_assistant" />
        </service>
        <service android:name=".voice.assistant.JarvisAssistantSessionService"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".voice.assistant.JarvisRecognitionService"
            android:exported="true" android:permission="android.permission.RECORD_AUDIO" />
        <activity android:name=".voice.assistant.JarvisAssistantPermissionActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="" android:theme="@style/Theme.Zeron.AssistantPermission" />
        <activity android:name=".voice.assistant.JarvisAssistantSettingsActivity"
            android:exported="true" android:excludeFromRecents="true" />
        <service android:name=".voice.JarvisService" android:exported="false" android:foregroundServiceType="microphone" />
        <receiver
            android:name=".core.TransferActionReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
