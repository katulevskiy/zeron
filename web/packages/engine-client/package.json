{
  "name": "@zeron/engine-client",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic supervised browser RPC over the owner-scoped cookie relay, with engine identity re-verification, typed calls, backoff, watches, and shared frame codecs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:conformance": "vitest run --project conformance",
    "test:smoke": "vitest run --project smoke",
    "test:relay": "vitest run --config tests/browser-relay.config.ts",
    "test:sidebar": "vitest run --config tests/sidebar-relay.config.ts",
    "test:sidebar-browser": "vitest run --config tests/sidebar-visual.config.ts"
  },
  "dependencies": {
    "@zeron/proto": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "playwright": "1.61.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
