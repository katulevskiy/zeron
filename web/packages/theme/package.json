{
  "name": "@zeron/theme",
  "version": "0.0.0",
  "private": true,
  "description": "Zeron web design tokens and Geist fonts. Builtin theme variants and accent derivations are exported from upstream Rust by zeron-theme-export; layout and motion tokens are explicitly browser-owned.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fonts.css": "./fonts.css",
    "./artifact.json": "./src/generated/artifact.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "regenerate": "cargo run --locked -p zeron-theme --bin zeron-theme-export",
    "regenerate:check": "cargo run --locked -p zeron-theme --bin zeron-theme-export -- --check"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
