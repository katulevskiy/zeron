{
  "name": "@zeron/app",
  "version": "0.0.0",
  "private": true,
  "description": "The Zeron browser candidate — Vite + React + TanStack Router with @zeron/theme tokens, served with the same-origin owner-scoped cookie relay backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:projects": "vitest run --config tests/project-relay.config.ts"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@pierre/diffs": "1.5.1",
    "@tanstack/react-router": "^1.132.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zeron/engine-client": "workspace:*",
    "@zeron/icons": "workspace:*",
    "@zeron/proto": "workspace:*",
    "@zeron/theme": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.0",
    "playwright": "1.61.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
